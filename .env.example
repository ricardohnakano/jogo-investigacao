# Anthropic API key (Claude). Pegue em https://console.anthropic.com
# Necessário pra geração da história e dicas via LLM (PR 4+).
# Pra rodar sem queimar API (mock mode), deixa em branco e use JOGO_MOCK_LLM=1.
ANTHROPIC_API_KEY=

# Servidor
HOST=0.0.0.0
PORT=8000

# OpenAI API key (DALL-E 3). Pegue em https://platform.openai.com
# Necessário pra geração da imagem da cena do crime (PR 5+).
# Com JOGO_MOCK_LLM=1, a imagem é gerada localmente pelo Pillow (sem API).
OPENAI_API_KEY=

# Mock mode pro pipeline LLM e geração de imagem. Define JOGO_MOCK_LLM=1 pra
# usar fixtures em data/mock_llm/ ao invés das APIs reais. Útil pra dev e testes.
# JOGO_MOCK_LLM=
