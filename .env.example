# Anthropic API key (Claude). Pegue em https://console.anthropic.com
# Necessário pra geração da história e dicas via LLM (PR 4+).
# Pra rodar sem queimar API (mock mode), deixa em branco e use JOGO_MOCK_LLM=1.
ANTHROPIC_API_KEY=

# Servidor
HOST=0.0.0.0
PORT=8000

# Mock mode pro pipeline LLM. Define JOGO_MOCK_LLM=1 pra usar fixtures em
# data/mock_llm/ ao invés da API real. Útil pra dev e testes.
# JOGO_MOCK_LLM=
